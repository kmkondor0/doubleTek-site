---
import BaseLayout from '../layouts/BaseLayout.astro';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

const t = es;
const translations = { es, en };
const icons = ['code', 'mobile', 'sparkle', 'shield', 'cloud'];
---

<BaseLayout title={t.meta.title} description={t.meta.description}>
  <canvas id="tech-canvas" aria-hidden="true"></canvas>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="site-header" id="top">
    <a class="brand" href="#top" aria-label="DoubleTek, inicio">
      <svg class="brand-mark" viewBox="0 0 54 54" fill="none" aria-hidden="true"><path d="M4 9h23c13.2 0 22 7.1 22 18s-8.8 18-22 18H4V9Z" fill="currentColor"/><path d="M4 18h23c7.2 0 12 3 12 9s-4.8 9-12 9H4V18Z" fill="#0b0c10"/><path d="M18 9h9v36h-9z" fill="#8B7AFF"/></svg>
      <span>Double<span>Tek</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#servicios" data-i18n="nav.services">Servicios</a>
      <a href="#capacidades" data-i18n="nav.capabilities">Capacidades</a>
      <a href="#nosotros" data-i18n="nav.about">Nosotros</a>
      <a href="#contacto" data-i18n="nav.contact">Contacto</a>
    </nav>
    <div class="header-actions">
      <button class="language-switch" id="language-switch" type="button" aria-label="Cambiar idioma">
        <span class="active-lang">ES</span><span>/</span><span class="inactive-lang">EN</span>
      </button>
      <a class="button button-small header-cta" href="#contacto" data-i18n="nav.start">Iniciar proyecto</a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-i18n-aria="nav.menu">
        <span></span><span></span>
      </button>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil">
      <a href="#servicios" data-i18n="nav.services">Servicios</a><a href="#capacidades" data-i18n="nav.capabilities">Capacidades</a><a href="#nosotros" data-i18n="nav.about">Nosotros</a><a href="#contacto" data-i18n="nav.contact">Contacto</a>
    </nav>
  </header>

  <main>
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-content reveal">
        <p class="eyebrow"><span class="status-dot"></span><span data-i18n="hero.eyebrow">Ingeniería de precisión · México / Global</span></p>
        <h1 id="hero-title"><span data-i18n="hero.titleA">Construimos el</span> <em data-i18n="hero.titleHighlight">próximo</em><br /><span data-i18n="hero.titleB">salto de tu negocio.</span></h1>
        <p class="hero-copy" data-i18n="hero.copy">Diseñamos software de alto calibre, inteligencia artificial aplicada y plataformas digitales preparadas para escalar. Transformamos retos complejos en ventajas operativas medibles para organizaciones que lideran el cambio.</p>
        <div class="hero-actions">
          <a class="button" href="#contacto"><span data-i18n="hero.quote">Cotizar proyecto</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a class="text-link" href="#servicios"><span data-i18n="hero.solutions">Conoce nuestras soluciones</span><span class="arrow">↓</span></a>
        </div>
      </div>
      <div class="hero-visual reveal" aria-hidden="true">
        <div class="orbital-ring ring-1"></div><div class="orbital-ring ring-2"></div>
        <div class="core"><span>DT</span><i></i><i></i><i></i></div>
        <div class="data-chip chip-a">AI <span>01</span></div><div class="data-chip chip-b">SYS <span>∞</span></div><div class="data-chip chip-c">MX <span>CDMX</span></div>
      </div>
      <a class="scroll-cue" href="#servicios"><span data-i18n="hero.scroll">Explora DoubleTek</span><i></i></a>
    </section>

    <section id="servicios" class="services section-shell section-pad" aria-labelledby="services-title">
      <div class="section-head reveal"><p class="eyebrow" data-i18n="services.eyebrow">Lo que hacemos</p><h2 id="services-title" data-i18n="services.title">Capacidad técnica que se traduce en impulso.</h2><p data-i18n="services.copy">Desde la definición de una estrategia hasta la operación en producción, conformamos equipos senior que resuelven retos complejos con claridad, velocidad y una disciplina de ingeniería que perdura.</p></div>
      <div class="services-grid">
        {t.services.items.map((service, index) => <article class:list={["service-card", `service-${index}`, 'reveal']} style={`--delay: ${index * 70}ms`}>
          <div class="service-top"><span class="service-index">0{index + 1}</span><span class="icon-box"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">{icons[index] === 'code' && <><path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/></>}{icons[index] === 'mobile' && <><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></>}{icons[index] === 'sparkle' && <><path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3ZM19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"/></>}{icons[index] === 'shield' && <path d="M12 3 19 6v5c0 4.7-2.9 8.3-7 10-4.1-1.7-7-5.3-7-10V6l7-3Z"/>}{icons[index] === 'cloud' && <path d="M7 18h10a4 4 0 0 0 .7-7.94A6 6 0 0 0 6.12 11.4 3.3 3.3 0 0 0 7 18Z"/>}</svg></span></div>
          <h3 data-i18n={`services.items.${index}.title`}>{service.title}</h3><p data-i18n={`services.items.${index}.description`}>{service.description}</p><span class="card-arrow">↗</span>
        </article>)}
      </div>
    </section>

    <section id="capacidades" class="capabilities section-shell section-pad" aria-labelledby="capabilities-title">
      <div class="capabilities-copy reveal"><p class="eyebrow" data-i18n="capabilities.eyebrow">Forma de trabajar</p><h2 id="capabilities-title" data-i18n="capabilities.title">La velocidad importa.<br />La precisión también.</h2><p data-i18n="capabilities.copy">Convertimos la complejidad técnica en sistemas confiables, observables y sostenibles: productos que tus equipos pueden operar con confianza, evolucionar con control y escalar sin comprometer la calidad.</p><ul>{t.capabilities.points.map((point, index) => <li data-i18n={`capabilities.points.${index}`}><span>0{index + 1}</span>{point}</li>)}</ul></div>
      <div class="capability-grid reveal">{t.capabilities.metrics.map((metric, index) => <div class="metric"><strong>{metric.value}</strong><span data-i18n={`capabilities.metrics.${index}.label`}>{metric.label}</span></div>)}<div class="grid-glow"></div></div>
    </section>

    <section id="nosotros" class="about section-shell section-pad" aria-labelledby="about-title">
      <div class="about-art reveal" aria-hidden="true"><div class="axis a1"></div><div class="axis a2"></div><div class="axis a3"></div><div class="about-monogram">D<span>T</span></div><p>19.43° N<br />99.13° W</p></div>
      <div class="about-copy reveal"><p class="eyebrow" data-i18n="about.eyebrow">Por qué DoubleTek</p><h2 id="about-title" data-i18n="about.title">Dos fuerzas, una ventaja decisiva.</h2><p data-i18n="about.copy">Somos una firma tecnológica mexicana que combina pensamiento de producto e ingeniería de precisión. Nos integramos a la ambición de tu negocio para convertir decisiones complejas en tecnología robusta, útil y lista para competir a escala global.</p><div class="tags"><span data-i18n="about.tag1">Estratégicos</span><span data-i18n="about.tag2">Ágiles</span><span data-i18n="about.tag3">Rigurosos</span></div><p class="made-in"><svg viewBox="0 0 20 20" fill="none"><path d="M10 2v16M2 10h16" stroke="currentColor" stroke-width="1.2"/></svg><span data-i18n="about.label">Diseñado e impulsado en México para el mundo.</span></p></div>
    </section>

    <section id="contacto" class="contact section-shell section-pad" aria-labelledby="contact-title">
      <div class="contact-intro reveal"><p class="eyebrow" data-i18n="contact.eyebrow">Empecemos</p><h2 id="contact-title" data-i18n="contact.title">Tu siguiente ventaja empieza con una conversación.</h2><p data-i18n="contact.copy">Cuéntanos qué quieres transformar, construir o acelerar. Te responderemos con una conversación directa, perspectiva técnica honesta y una ruta clara para avanzar.</p><div class="contact-details"><a href="mailto:contacto@doubletek.vip"><span data-i18n="contact.emailLabel">Escríbenos</span>contacto@doubletek.vip ↗</a><a href="https://doubletek.vip"><span data-i18n="contact.domainLabel">Visítanos</span>doubletek.vip ↗</a></div></div>
      <form class="contact-form reveal" id="contact-form"><label><span data-i18n="contact.name">Tu nombre</span><input required name="name" autocomplete="name" /></label><label><span data-i18n="contact.email">Correo de trabajo</span><input required type="email" name="email" autocomplete="email" /></label><label><span data-i18n="contact.company">Empresa (opcional)</span><input name="company" autocomplete="organization" /></label><label><span data-i18n="contact.message">¿Qué te gustaría construir?</span><textarea required name="message" rows="4"></textarea></label><button class="button form-button" type="submit"><span data-i18n="contact.send">Enviar solicitud</span><svg viewBox="0 0 20 20" fill="none"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button><p class="form-note" data-i18n="contact.privacy">Al enviar, abrirás tu cliente de correo. Sin trackers, sin ruido.</p><p class="form-success" id="form-success" aria-live="polite"></p></form>
    </section>
  </main>

  <footer class="footer section-shell"><a class="brand" href="#top"><svg class="brand-mark" viewBox="0 0 54 54" fill="none" aria-hidden="true"><path d="M4 9h23c13.2 0 22 7.1 22 18s-8.8 18-22 18H4V9Z" fill="currentColor"/><path d="M4 18h23c7.2 0 12 3 12 9s-4.8 9-12 9H4V18Z" fill="#0b0c10"/><path d="M18 9h9v36h-9z" fill="#8B7AFF"/></svg><span>Double<span>Tek</span></span></a><p>© 2026 DoubleTek. <span data-i18n="footer.rights">Todos los derechos reservados.</span></p><div class="footer-right"><a href="https://www.linkedin.com/in/doubletek/" target="_blank" rel="noreferrer" data-i18n="footer.linkedin">LinkedIn</a><a href="https://instagram.com" target="_blank" rel="noreferrer" data-i18n="footer.instagram">Instagram</a><span data-i18n="footer.made">Diseñado e impulsado en México para el mundo.</span></div></footer>

  <script is:inline define:vars={{ translations }}>
    const getPath = (object, path) => path.split('.').reduce((value, key) => {
      if (typeof value === 'object' && value !== null) return value[key];
      return undefined;
    }, object);
    let language = 'es';
    const languageButton = document.querySelector('#language-switch');
    const applyLanguage = (lang) => {
      language = lang;
      const dictionary = translations[lang];
      document.documentElement.lang = lang;
      document.title = String(getPath(dictionary, 'meta.title'));
      document.querySelector('meta[name="description"]')?.setAttribute('content', String(getPath(dictionary, 'meta.description')));
      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const value = getPath(dictionary, element.dataset.i18n || '');
        if (typeof value === 'string') element.innerHTML = value.replace(/\n/g, '<br>');
      });
      document.querySelectorAll('[data-i18n-aria]').forEach((element) => {
        const value = getPath(dictionary, element.dataset.i18nAria || '');
        if (typeof value === 'string') element.setAttribute('aria-label', value);
      });
      languageButton?.querySelector('.active-lang')?.replaceChildren(lang.toUpperCase());
      languageButton?.querySelector('.inactive-lang')?.replaceChildren(lang === 'es' ? 'EN' : 'ES');
      localStorage.setItem('doubletek-language', lang);
    };
    const remembered = localStorage.getItem('doubletek-language');
    if (remembered === 'en' || remembered === 'es') applyLanguage(remembered);
    document.documentElement.classList.remove('no-js');
    languageButton?.addEventListener('click', () => applyLanguage(language === 'es' ? 'en' : 'es'));

    const mobileNav = document.querySelector('#mobile-menu');
    const mobileMenuButton = document.querySelector('#menu-toggle');
    mobileMenuButton?.addEventListener('click', () => { const isOpen = mobileNav?.classList.toggle('is-open'); mobileMenuButton.setAttribute('aria-expanded', String(isOpen)); });
    mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { mobileNav?.classList.remove('is-open'); mobileMenuButton?.setAttribute('aria-expanded', 'false'); }));

    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

    document.querySelector('#contact-form')?.addEventListener('submit', (event) => {
      event.preventDefault(); const form = new FormData(event.currentTarget); const subject = encodeURIComponent(`Nuevo proyecto DoubleTek — ${form.get('name')}`); const body = encodeURIComponent(`Nombre: ${form.get('name')}\nCorreo: ${form.get('email')}\nEmpresa: ${form.get('company') || '—'}\n\nProyecto:\n${form.get('message')}`); window.location.href = `mailto:contacto@doubletek.vip?subject=${subject}&body=${body}`;
      const success = document.querySelector('#form-success'); if (success) success.textContent = String(getPath(translations[language], 'contact.success'));
    });

    const canvas = document.querySelector('#tech-canvas');
    if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const context = canvas.getContext('2d'); let pointer = { x: -1000, y: -1000 }; let nodes = [];
      const resize = () => { canvas.width = window.innerWidth * Math.min(devicePixelRatio, 2); canvas.height = window.innerHeight * Math.min(devicePixelRatio, 2); canvas.style.width = `${window.innerWidth}px`; canvas.style.height = `${window.innerHeight}px`; const scale = Math.min(devicePixelRatio, 2); context?.setTransform(scale, 0, 0, scale, 0, 0); nodes = Array.from({ length: Math.min(72, Math.max(38, Math.round(window.innerWidth / 19))) }, () => ({ x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight, vx: (Math.random() - .5) * .19, vy: (Math.random() - .5) * .19 })); };
      const draw = () => { if (!context) return; context.clearRect(0, 0, window.innerWidth, window.innerHeight); for (let i = 0; i < nodes.length; i++) { const node = nodes[i]; node.x += node.vx; node.y += node.vy; if (node.x < 0 || node.x > window.innerWidth) node.vx *= -1; if (node.y < 0 || node.y > window.innerHeight) node.vy *= -1; const distanceToPointer = Math.hypot(node.x - pointer.x, node.y - pointer.y); if (distanceToPointer < 210) { node.vx += (node.x - pointer.x) / 62000; node.vy += (node.y - pointer.y) / 62000; } node.vx *= .995; node.vy *= .995; for (let j = i + 1; j < nodes.length; j++) { const other = nodes[j]; const distance = Math.hypot(node.x - other.x, node.y - other.y); if (distance < 155) { context.strokeStyle = `rgba(104, 227, 255, ${.16 * (1 - distance / 155)})`; context.lineWidth = 1; context.beginPath(); context.moveTo(node.x, node.y); context.lineTo(other.x, other.y); context.stroke(); } } context.fillStyle = distanceToPointer < 210 ? 'rgba(165, 137, 255, .88)' : 'rgba(113, 229, 255, .58)'; context.beginPath(); context.arc(node.x, node.y, 1.55, 0, Math.PI * 2); context.fill(); } requestAnimationFrame(draw); };
      window.addEventListener('pointermove', (event) => pointer = { x: event.clientX, y: event.clientY }, { passive: true }); window.addEventListener('resize', resize, { passive: true }); resize(); draw();
    }
  </script>
</BaseLayout>
